# =============================================================================
# LeadMonster — Environment Variables Template
# Kopiere diese Datei nach .env.local und fülle die Werte ein.
# Niemals echte Secrets in dieses File!
# =============================================================================

# Anthropic Claude API — Content-Generierung
ANTHROPIC_API_KEY=

# AI-Provider — Vercel AI Gateway (bevorzugt) ODER direkter OpenAI-Key.
# Wenn AI_GATEWAY_API_KEY gesetzt ist, laufen Bildgenerierung + Vision-Style-
# Analyse durch das Gateway (https://ai-gateway.vercel.sh). Modelle bekommen
# automatisch das `openai/`-Prefix. Sonst fallback auf direkten OpenAI-Endpoint.
AI_GATEWAY_API_KEY=

# Legacy / Fallback — direkter OpenAI-Key (gpt-image-1, gpt-4o-mini Vision, OpenAI text provider)
OPENAI_API_KEY=

# Supabase — Project Settings → API Keys + Database → Connection string
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# DATABASE_URL Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Base URL für absolute URLs (Schema.org, Sitemap, OG-Bilder, Supabase Auth Redirects)
NEXT_PUBLIC_BASE_URL=
# Required — Hauptdomain MIT https://, z.B. https://www.sterbegeld24plus.de
# Wichtig: In Production niemals localhost eintragen (sonst Supabase E-Mail-Links brechen)

# Internal API-zu-API Auth
INTERNAL_SECRET=
# Required — shared secret für internal Endpoints (z.B. /api/seo/llms)

# Resend — Transaktionale E-Mails (Lead-Bestätigung + Sales-Notification)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Verified sender domain in Resend (z.B. noreply@yourdomain.de)
SALES_NOTIFICATION_EMAIL=
# Vertriebs-Mail für Lead-Notifications

# Convexa — CRM (Lead-Sync nach Form-Submit)
# Endpoint: POST https://api.convexa.app/submissions/{Formular-Token}
# Der Form-Token ist pro Kampagne unterschiedlich — ein globaler Default
# kann hier hinterlegt werden, pro Produkt überschreibbar via
# produkte.convexa_form_token (Admin-UI).
CONVEXA_BASE_URL=
# Default: https://api.convexa.app
CONVEXA_FORM_TOKEN=
# Globaler Default-Token aus convexa.app/admin → Formular → Embed/Token

# Unsplash — Optional, für Stock-Bilder als Fallback zu KI
UNSPLASH_ACCESS_KEY=

# Meta (Facebook) Pixel — Marketing-Tracking nach Cookie-Einwilligung
NEXT_PUBLIC_META_PIXEL_ID=
# Default in code: 374844728246470 (Sterbegeld24Plus). Override per env if needed.

# Cloudflare Turnstile — Bot-Schutz für Lead-Formulare (Anbieter-Option)
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Alternativ in Admin → Einstellungen speichern (einstellungen-Tabelle).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA

# hCaptcha — alternative checkbox captcha (Admin → provider = hcaptcha)
# Keys: https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Optional override: CAPTCHA_PROVIDER=turnstile|hcaptcha
CAPTCHA_PROVIDER=